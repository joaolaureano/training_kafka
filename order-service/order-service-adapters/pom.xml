<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.joaolaureano.trainingkafka</groupId>
    <artifactId>order-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>order-service-adapters</artifactId>
  <name>order-service :: adapters</name>

  <!-- É aqui, e só aqui, que a tecnologia entra. -->
  <dependencies>
    <dependency>
      <groupId>dev.joaolaureano.trainingkafka</groupId>
      <artifactId>order-service-domain</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Este módulo NÃO pode enxergar a camada de aplicação.

        Os adapters de entrada declaram, no próprio pacote, a interface de que
        precisam; quem a implementa é uma facade montada no módulo -bootstrap.
        Se alguém reintroduzir a dependência para encurtar caminho, o build
        quebra aqui — a separação é do compilador, não da disciplina.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-adapters-independence</id>
            <phase>validate</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>dev.joaolaureano.trainingkafka:order-service-application</exclude>
                  </excludes>
                  <message>
                    O módulo -adapters não pode depender do módulo -application.
                    Declare aqui a interface de que o adapter precisa e implemente-a
                    como facade no módulo -bootstrap, que é a raiz de composição.
                  </message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
